# Public browser configuration only. Never put service-role or provider secrets in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Public SDK keys from the matching RevenueCat apps. Leave blank until native store plans are ready.
VITE_REVENUECAT_APPLE_KEY=
VITE_REVENUECAT_ANDROID_KEY=
