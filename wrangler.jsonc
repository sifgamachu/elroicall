{
  // El Roi Call — React site + worker (indexing pinger, transcribe utility)
  "name": "elroicall",
  "compatibility_date": "2026-07-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["0 6 * * *"] }
}
